<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
    body {
        font-family: Helvetica, Arial, sans-serif;
        font-size: 10pt;
        color: #222222;
        margin: 30px;
        line-height: 1.4;
    }
    .header-table {
        width: 100%;
        margin-bottom: 15px;
        border-bottom: 2px solid #b30000;
        padding-bottom: 8px;
    }
    .header-title {
        font-size: 18pt;
        font-weight: bold;
        color: #b30000;
    }
    .header-sub {
        font-size: 9pt;
        color: #555555;
    }
    .case-badge {
        text-align: right;
        font-size: 9pt;
        color: #333333;
    }
    h2 {
        font-size: 12pt;
        color: #1a252f;
        background-color: #f0f3f6;
        padding: 5px;
        margin-top: 15px;
        margin-bottom: 6px;
        border-left: 4px solid #b30000;
    }
    table.data-table {
        width: 100%;
        margin-top: 4px;
        margin-bottom: 10px;
    }
    table.data-table th {
        width: 30%;
        background-color: #eaeded;
        font-weight: bold;
        padding: 5px;
        font-size: 9pt;
        text-align: left;
        border: 1px solid #cccccc;
    }
    table.data-table td {
        padding: 5px;
        font-size: 9pt;
        border: 1px solid #cccccc;
    }
    .risk-high {
        background-color: #d9534f;
        color: #ffffff;
        font-weight: bold;
        padding: 3px 8px;
    }
    .risk-medium {
        background-color: #f0ad4e;
        color: #000000;
        font-weight: bold;
        padding: 3px 8px;
    }
    .risk-low {
        background-color: #5cb85c;
        color: #ffffff;
        font-weight: bold;
        padding: 3px 8px;
    }
    table.comparison-table {
        width: 100%;
        margin-top: 6px;
    }
    table.comparison-table td {
        width: 50%;
        text-align: center;
        vertical-align: top;
        padding: 5px;
        border: 1px solid #dddddd;
    }
    .tag-real {
        background-color: #2e7d32;
        color: #ffffff;
        font-weight: bold;
        padding: 4px;
        font-size: 9pt;
    }
    .tag-fake {
        background-color: #c62828;
        color: #ffffff;
        font-weight: bold;
        padding: 4px;
        font-size: 9pt;
    }
    .notice-box {
        background-color: #fff9e6;
        border: 1px solid #ffe082;
        padding: 6px;
        font-size: 8.5pt;
        margin-top: 8px;
    }
    .footer-note {
        margin-top: 20px;
        font-size: 8pt;
        color: #666666;
        border-top: 1px solid #dddddd;
        padding-top: 6px;
    }
</style>
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width: 70%;">
            <div class="header-title">SECURITY INCIDENT TAKEDOWN DOSSIER</div>
            <div class="header-sub">Brand Impersonation, Credential Harvesting & Typosquat Threat Intelligence</div>
        </td>
        <td class="case-badge" style="width: 30%;">
            <strong>CASE REF:</strong> TSM-INC-{{ incident_id|default("9041") }}<br>
            <strong>DATE:</strong> {{ generated_at }}<br>
            <strong>SEVERITY:</strong> {{ risk_level }}
        </td>
    </tr>
</table>

<div class="notice-box">
    <strong>CONFIDENTIAL ABUSE REPORT:</strong> This automated forensic intelligence dossier has been generated to substantiate immediate administrative suspension and domain takedown under the ICANN Uniform Domain-Name Dispute-Resolution Policy (UDRP) and registrar Anti-Phishing abuse terms.
</div>

<h2>1. Executive Incident Summary</h2>
<table class="data-table">
    <tr>
        <th>Infringing Candidate Domain</th>
        <td><strong>{{ domain }}</strong></td>
    </tr>
    {% if decoded_domain %}
    <tr>
        <th>Decoded Unicode / Homoglyph</th>
        <td><strong style="color: #b30000;">{{ decoded_domain }}</strong> (IDN Punycode Confusable)</td>
    </tr>
    {% endif %}
    <tr>
        <th>Targeted Enterprise Brand</th>
        <td><strong>{{ matched_brand }}</strong></td>
    </tr>
    <tr>
        <th>Detection Timestamp</th>
        <td>{{ detected_at }}</td>
    </tr>
    <tr>
        <th>Composite Threat Risk Score</th>
        <td>
            <span class="risk-{{ risk_level|lower }}">{{ risk_score }}/100 — {{ risk_level }} SEVERITY</span>
        </td>
    </tr>
    <tr>
        <th>Active Status</th>
        <td>{{ "LIVE (Active and Weaponized)" if is_live else "OFFLINE / Inactive" }}</td>
    </tr>
</table>

<h2>2. Multi-Vector Threat Indicators & Forensic Signals</h2>
<table class="data-table">
    <tr>
        <th>DNS IPv4 Resolution</th>
        <td>{{ ip_address if ip_address else ("Live host (Resolves)" if is_live else "Unresolved / Offline") }}</td>
    </tr>
    <tr>
        <th>Computer Vision Similarity</th>
        <td>{{ visual_similarity }} / 1.0 (pHash Hamming distance algorithm)</td>
    </tr>
    <tr>
        <th>Credential Harvesting Forms</th>
        <td>{{ "CONFIRMED (&lt;input type='password'&gt; form present)" if has_login_form else "None Detected" }}</td>
    </tr>
    <tr>
        <th>Suspicious Phishing Lures</th>
        <td>{{ suspicious_phrases if suspicious_phrases else "None matched" }}</td>
    </tr>
    <tr>
        <th>Mail Exchanger (MX) Infrastructure</th>
        <td>{{ "DETECTED (Configured for Spear-Phishing / Email Impersonation)" if has_mx_record else "No active MX records" }}</td>
    </tr>
    <tr>
        <th>TLS Certificate Telemetry</th>
        <td>{{ ssl_issuer if ssl_issuer else "Standard Domain Validation" }}</td>
    </tr>
</table>

{% if screenshot_path or reference_screenshot_path %}
<h2>3. Visual Evidence — Legitimate Brand vs. Impersonating Candidate</h2>
<table class="comparison-table">
    <tr>
        <td>
            <div class="tag-real">AUTHENTIC: {{ matched_brand }}</div>
            <div>
                {% if reference_screenshot_path %}
                <img src="{{ reference_screenshot_path }}" width="240" height="150" alt="Authentic Brand Site">
                {% else %}
                <p><em>Reference image unavailable</em></p>
                {% endif %}
            </div>
        </td>
        <td>
            <div class="tag-fake">IMPERSONATOR: {{ domain }}</div>
            <div>
                {% if screenshot_path %}
                <img src="{{ screenshot_path }}" width="240" height="150" alt="Infringing Candidate Screenshot">
                {% else %}
                <p><em>Candidate screenshot unavailable</em></p>
                {% endif %}
            </div>
        </td>
    </tr>
</table>
{% endif %}

<h2>4. Registrar & Abuse Contact Dossier</h2>
{% if registrar or emails %}
<table class="data-table">
    <tr>
        <th>Designated Registrar</th>
        <td>{{ registrar if registrar else "Not reported by RDAP" }}</td>
    </tr>
    <tr>
        <th>Registration Date</th>
        <td>{{ creation_date if creation_date else "Recent / Redacted" }}</td>
    </tr>
    <tr>
        <th>Registrar Abuse Email(s)</th>
        <td><strong>{{ emails|join(", ") if emails else "abuse-mailbox@registrar" }}</strong></td>
    </tr>
    <tr>
        <th>Authoritative Name Servers</th>
        <td>{{ name_servers|join(", ") if name_servers else "Standard Anycast" }}</td>
    </tr>
</table>
{% else %}
<p><em>RDAP registry query returned redacted entity records. Please submit complaint to ICANN compliance and authoritative registrar abuse desk.</em></p>
{% endif %}

<h2>5. Formal Takedown Request Notice (ICANN / Abuse Desk)</h2>
<div class="notice-box">
    <strong>TO THE ABUSE DESK / REGISTRAR COMPLIANCE:</strong><br>
    Please be advised that domain <strong>{{ domain }}</strong> is engaged in unauthorized brand impersonation, deceptive trademark use, and credential interception targeting users of <strong>{{ matched_brand }}</strong>.<br><br>
    We hereby formally request immediate suspension of DNS resolution (ClientHold / ServerHold) pursuant to Section 3.18 of the ICANN Registrar Accreditation Agreement (RAA) and Anti-Abuse Acceptable Use Policies.
</div>

<div class="footer-note">
    Dossier compiled by Typosquat & Brand Impersonation Threat Intelligence Platform (Final Year Project).<br>
    Cryptographic Hash Verification: Perceptual Hashing & DOM AST Parsing Engine.
</div>

</body>
</html>
